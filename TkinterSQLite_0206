import sqlite3

DB_NAME = "prediksi_diabetes.db"


def run_query(sql, params=()):
    conn = sqlite3.connect(DB_NAME)

    try:
        with conn:
            return conn.execute(sql, params).fetchall()
    finally:
        conn.close()


def init_db():
    run_query("""
        CREATE TABLE IF NOT EXISTS pasien (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            nama_pasien TEXT NOT NULL,
            usia INTEGER NOT NULL,
            gula_darah REAL NOT NULL,
            bmi REAL NOT NULL,
            riwayat_ortu TEXT NOT NULL,
            hasil_prediksi TEXT NOT NULL
        )
    """)


init_db()

def prediksi_diabetes(gula_darah, bmi, riwayat_ortu):

    if gula_darah >= 200:

        if bmi >= 30 or riwayat_ortu == "Ya":
            return "Sangat Tinggi"
        else:
            return "Tinggi"

    elif gula_darah >= 140:

        if bmi >= 30 and riwayat_ortu == "Ya":
            return "Tinggi"
        else:
            return "Sedang"

    else:

        if bmi >= 30:

            if riwayat_ortu == "Ya":
                return "Sedang"
            else:
                return "Waspada"

        elif riwayat_ortu == "Ya":
            return "Waspada"

        else:
            return "Rendah"

from tkinter import messagebox


def baca_form():

    nama = entry_nama.get().strip()
    usia = entry_usia.get().strip()
    gula_darah = entry_gula.get().strip()
    bmi = entry_bmi.get().strip()
    riwayat_ortu = combo_ortu.get().strip()

    if not nama or not usia or not gula_darah or not bmi or not riwayat_ortu:
        messagebox.showwarning(
            "Data Tidak Lengkap",
            "Semua data harus diisi."
        )
        return None

    if not nama.replace(" ", "").isalpha():
        messagebox.showwarning(
            "Nama Tidak Valid",
            "Nama pasien hanya boleh berisi huruf."
        )
        return None

    try:
        usia = int(usia)
    except ValueError:
        messagebox.showwarning(
            "Usia Tidak Valid",
            "Usia harus berupa angka."
        )
        return None

    if usia <= 0 or usia > 120:
        messagebox.showwarning(
            "Usia Tidak Valid",
            "Usia harus antara 1 sampai 120 tahun."
        )
        return None

    try:
        gula_darah = float(gula_darah)
    except ValueError:
        messagebox.showwarning(
            "Gula Darah Tidak Valid",
            "Kadar gula darah harus berupa angka."
        )
        return None

    if gula_darah <= 0:
        messagebox.showwarning(
            "Gula Darah Tidak Valid",
            "Kadar gula darah harus lebih dari 0."
        )
        return None

    try:
        bmi = float(bmi)
    except ValueError:
        messagebox.showwarning(
            "BMI Tidak Valid",
            "BMI harus berupa angka."
        )
        return None

    if bmi <= 0 or bmi > 100:
        messagebox.showwarning(
            "BMI Tidak Valid",
            "BMI tidak valid."
        )
        return None

    return nama, usia, gula_darah, bmi, riwayat_ortu

def proses_prediksi():

    data = baca_form()

    if data is None:
        return

    nama, usia, gula_darah, bmi, riwayat_ortu = data

    hasil = prediksi_diabetes(
        gula_darah,
        bmi,
        riwayat_ortu
    )

    label_hasil.config(
        text=f"Hasil Prediksi: {hasil}"
    )

if hasil == "Rendah":
    label_hasil.config(fg="green")

elif hasil == "Waspada":
    label_hasil.config(fg="orange")

elif hasil == "Sedang":
    label_hasil.config(fg="blue")

elif hasil == "Tinggi":
    label_hasil.config(fg="red")

elif hasil == "Sangat Tinggi":
    label_hasil.config(fg="darkred")

    simpan_pasien(
        nama,
        usia,
        gula_darah,
        bmi,
        riwayat_ortu,
        hasil
    )

    messagebox.showinfo(
        "Berhasil",
        "Data berhasil disimpan."
    )
label_hasil = tk.Label(
    root,
    text="Hasil Prediksi: -",
    font=("Arial", 16, "bold")
)

label_hasil.pack(pady=20)

btn_prediksi = tk.Button(
    root,
    text="Prediksi",
    width=20,
    command=proses_prediksi
)

btn_prediksi.pack(pady=10)

def simpan_pasien(
    nama,
    usia,
    gula_darah,
    bmi,
    riwayat_ortu,
    hasil
):

    run_query("""
        INSERT INTO pasien
        (
            nama_pasien,
            usia,
            gula_darah,
            bmi,
            riwayat_ortu,
            hasil_prediksi
        )
        VALUES (?, ?, ?, ?, ?, ?)
    """, (
        nama,
        usia,
        gula_darah,
        bmi,
        riwayat_ortu,
        hasil
    ))


