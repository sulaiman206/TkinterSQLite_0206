import sqlite3
from tkinter import messagebox, ttk
import tkinter as tk

# =========================================================
# DATABASE
# =========================================================

DB_NAME = "prediksi_diabetes.db"


def run_query(sql, params=()):
  conn = sqlite3.connect(DB_NAME)
  try:
    with conn:
      return conn.execute(sql, params).fetchall()
  finally:
    conn.close()


def init_db():
  run_query("""
        CREATE TABLE IF NOT EXISTS pasien (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            nama_pasien TEXT NOT NULL,
            usia INTEGER NOT NULL,
            gula_darah REAL NOT NULL,
            bmi REAL NOT NULL,
            riwayat_ortu TEXT NOT NULL,
            hasil_prediksi TEXT NOT NULL
        )
    """)


# =========================================================
# PREDICTION
# =========================================================


def prediksi_diabetes(gula_darah, bmi, riwayat_ortu):
  if gula_darah >= 200:
    if bmi >= 30 or riwayat_ortu == "Ya":
      return "Sangat Tinggi"
    else:
      return "Tinggi"

  elif gula_darah >= 140:
    if bmi >= 30 and riwayat_ortu == "Ya":
      return "Tinggi"
    else:
      return "Sedang"

  else:
    if bmi >= 30:
      if riwayat_ortu == "Ya":
        return "Sedang"
      else:
        return "Waspada"

    elif riwayat_ortu == "Ya":
      return "Waspada"

    else:
      return "Rendah"


# =========================================================
# SAVE DATA
# =========================================================


def simpan_pasien(nama, usia, gula_darah, bmi, riwayat_ortu, hasil):
  run_query(
      """
        INSERT INTO pasien
        (
            nama_pasien,
            usia,
            gula_darah,
            bmi,
            riwayat_ortu,
            hasil_prediksi
        )
        VALUES (?, ?, ?, ?, ?, ?)
    """,
      (nama, usia, gula_darah, bmi, riwayat_ortu, hasil),
  )


# =========================================================
# GET DATA
# =========================================================


def get_all_patients():
  return run_query("""
        SELECT
            id,
            nama_pasien,
            usia,
            gula_darah,
            bmi,
            riwayat_ortu,
            hasil_prediksi
        FROM pasien
        ORDER BY id DESC
    """)


# =========================================================
# VALIDATION
# =========================================================


def baca_form():
  nama = entry_nama.get().strip()
  usia = entry_usia.get().strip()
  gula_darah = entry_gula.get().strip()
  bmi = entry_bmi.get().strip()
  riwayat_ortu = combo_ortu.get().strip()

  if not nama or not usia or not gula_darah or not bmi or not riwayat_ortu:
    messagebox.showwarning("Data Tidak Lengkap", "Semua data harus diisi.")
    return None

  if not nama.replace(" ", "").isalpha():
    messagebox.showwarning(
        "Nama Tidak Valid", "Nama pasien hanya boleh berisi huruf."
    )
    return None

  try:
    usia = int(usia)
  except ValueError:
    messagebox.showwarning("Usia Tidak Valid", "Usia harus berupa angka.")
    return None

  if usia <= 0 or usia > 120:
    messagebox.showwarning(
        "Usia Tidak Valid", "Usia harus antara 1 sampai 120 tahun."
    )
    return None

  try:
    gula_darah = float(gula_darah)
  except ValueError:
    messagebox.showwarning(
        "Gula Darah Tidak Valid", "Kadar gula darah harus berupa angka."
    )
    return None

  if gula_darah <= 0:
    messagebox.showwarning(
        "Gula Darah Tidak Valid", "Kadar gula darah harus lebih dari 0."
    )
    return None

  try:
    bmi = float(bmi)
  except ValueError:
    messagebox.showwarning("BMI Tidak Valid", "BMI harus berupa angka.")
    return None

  if bmi <= 0 or bmi > 100:
    messagebox.showwarning(
        "BMI Tidak Valid", "BMI harus berada dalam nilai yang wajar."
    )
    return None

  return (nama, usia, gula_darah, bmi, riwayat_ortu)


# =========================================================
# PREDICT
# =========================================================


def proses_prediksi():
  data = baca_form()

  if data is None:
    return

  nama, usia, gula_darah, bmi, riwayat_ortu = data

  hasil = prediksi_diabetes(gula_darah, bmi, riwayat_ortu)

  label_hasil.config(text=f"Hasil Prediksi: {hasil}")

  if hasil == "Rendah":
    label_hasil.config(fg="green")

  elif hasil == "Waspada":
    label_hasil.config(fg="orange")

  elif hasil == "Sedang":
    label_hasil.config(fg="blue")

  elif hasil == "Tinggi":
    label_hasil.config(fg="red")

  elif hasil == "Sangat Tinggi":
    label_hasil.config(fg="darkred")

  simpan_pasien(nama, usia, gula_darah, bmi, riwayat_ortu, hasil)

  messagebox.showinfo(
      "Berhasil", "Data pasien dan hasil prediksi berhasil disimpan."
  )


# =========================================================
# CLEAR
# =========================================================


def clear_form():
  entry_nama.delete(0, tk.END)
  entry_usia.delete(0, tk.END)
  entry_gula.delete(0, tk.END)
  entry_bmi.delete(0, tk.END)

  combo_ortu.set("")

  label_hasil.config(text="Hasil Prediksi: -", fg="black")


# =========================================================
# VIEW DATA
# =========================================================


def lihat_data():
  data_window = tk.Toplevel(root)

  data_window.title("Data Pasien")
  data_window.geometry("950x450")

  title = tk.Label(
      data_window, text="Riwayat Data Pasien", font=("Arial", 16, "bold")
  )

  title.pack(pady=10)

  frame = tk.Frame(data_window)
  frame.pack(fill="both", expand=True, padx=10, pady=10)

  columns = ("id", "nama", "usia", "gula", "bmi", "ortu", "hasil")

  tree = ttk.Treeview(frame, columns=columns, show="headings")

  tree.heading("id", text="ID")
  tree.heading("nama", text="Nama Pasien")
  tree.heading("usia", text="Usia")
  tree.heading("gula", text="Gula Darah")
  tree.heading("bmi", text="BMI")
  tree.heading("ortu", text="Riwayat Ortu")
  tree.heading("hasil", text="Hasil Prediksi")

  tree.column("id", width=50)
  tree.column("nama", width=180)
  tree.column("usia", width=70)
  tree.column("gula", width=100)
  tree.column("bmi", width=80)
  tree.column("ortu", width=100)
  tree.column("hasil", width=130)

  scrollbar = ttk.Scrollbar(frame, orient="vertical", command=tree.yview)

  tree.configure(yscrollcommand=scrollbar.set)

  tree.pack(side="left", fill="both", expand=True)

  scrollbar.pack(side="right", fill="y")

  for row in get_all_patients():
    tree.insert("", tk.END, values=row)


